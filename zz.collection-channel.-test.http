### 基础配置变量
@baseUrl = http://192.168.0.51:3000
@shopApi = {{baseUrl}}/shop-api
@adminApi = {{baseUrl}}/admin-api

### 🌟 渠道 A 的配置 (例如：中国区/小程序端)
@tokenChannelA = the-channel-token-for-channel-dsy
@collectionIdA = 16

### 🌟 渠道 B 的配置 (例如：海外区/独立站端)
@tokenChannelB = the-channel-token-wang
@collectionIdB = 2



@channelToken = the-channel-token-for-channel-dsy









##################


# 🔒 请将下方替换为您实际获取到的管理员账户 Bearer Token
@adminToken = 9a925ef2cd7a5a094619b9e5cc3bf980e9eb529b677d35beede30ba9a6ae117f

### 1. 成功测试：使用管理员身份穿透查询指定分类所属的【所有渠道】
POST {{adminApi}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "query": "query GetCollectionWithChannels($id: ID!) { collection(id: $id) { id name slug assignedChannels { id code token } } }",
  "variables": {
    "id": "5"
  }
}


### 2. 验证安全性测试（可选）：模拟非管理员（无 Token）访问
# 预期结果：应该直接被系统拒绝，抛出 "Unauthorized" 或权限不足的错误
POST {{adminApi}}
Content-Type: application/json

{
  "query": "query GetCollectionWithChannels($id: ID!) { collection(id: $id) { id assignedChannels { id code } } }",
  "variables": {
    "id": "2"
  }
}



##################





#####


### 查询指定分类被分配到了哪些渠道
POST {{adminApi}}
Content-Type: application/json
Authorization: Bearer 20bef5b294e4b70ae8da4e7e60afd9b9eec1c380f673c75f0671db8cec594941

{
  "query": "query GetCollectionChannels($id: ID!) { collection(id: $id) { id name slug channels { id code token } } }",
  "variables": {
    "id": "2"
  }
}








################


### 基础变量配置

### 获取当前渠道的所有分类（包含父级、子级和商品统计）
POST {{shopApi}}
Content-Type: application/json
vendure-token: {{channelToken}}

{
  "query": "query GetCollections { collections { items { id name slug parent { name } featuredAsset { id preview } children { id name slug featuredAsset { id preview } } productVariants { totalItems } productCount } } }"
}




#################













### ==========================================
### 测试场景 1：使用渠道 A 的 Token 请求它拥有的分类 A (正常获取)
### ==========================================
POST {{shopApi}}
Content-Type: application/json
vendure-token: {{tokenChannelA}}

{
  "query": "query GetCollectionSummary($id: ID!, $skip: Int, $take: Int) { collectionProductSummary(collectionId: $id, skip: $skip, take: $take) { productId productName slug variantCount minPrice maxPrice minPriceWithTax maxPriceWithTax featuredAsset { preview } facetValues { code name } } }",
  "variables": {
    "id": "{{collectionIdA}}",
    "skip": 0,
    "take": 10
  }
}

###

### ==========================================
### 测试场景 2：越权测试！用渠道 B 的 Token 去偷看渠道 A 的分类 (预期结果：返回空数组 [])
### ==========================================
POST {{shopApi}}
Content-Type: application/json
vendure-token: {{tokenChannelB}}

{
  "query": "query CrossChannelAttack($id: ID!) { collectionProductSummary(collectionId: $id) { productId productName } }",
  "variables": {
    "id": "{{collectionIdA}}"
  }
}

###

### ==========================================
### 测试场景 3：使用渠道 B 的 Token 请求它自己的分类 B (正常获取)
### ==========================================
POST {{shopApi}}
Content-Type: application/json
vendure-token: {{tokenChannelB}}

{
  "query": "query GetChannelBSummary($id: ID!) { collectionProductSummary(collectionId: $id) { productId productName minPriceWithTax } }",
  "variables": {
    "id": "{{collectionIdB}}"
  }
}














