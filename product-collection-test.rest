@baseUrl = http://localhost:3000/admin-api
@token = YOUR_AUTH_TOKEN

### Test Create Product without Collections
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreateProductTest($input: CreateProductInput!) { createProduct(input: $input) { id name slug description featuredAsset { id name preview } assets { id name } facetValues { id code name } collections { id slug name } } }",
  "variables": {
    "input": {
      "translations": [
        {
          "languageCode": "en",
          "name": "Desktop",
          "slug": "desktop",
          "description": "desc Desktop GPU, SSDs and Turbo CPU type."
        }
      ],
      "featuredAssetId": "133",
      "assetIds": ["134", "135", "136"],
      "facetValueIds": ["1", "2", "3"]
    }
  }
}

### Test Update Product to Add Collections
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation UpdateProductTest($input: UpdateProductInput!) { updateProduct(input: $input) { id name slug collections { id slug name } } }",
  "variables": {
    "input": {
      "id": "PRODUCT_ID_FROM_CREATE_RESPONSE",
      "collectionIds": ["2", "3"]
    }
  }
}

### Test Full Product Query (to verify everything worked)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetProductTest($slug: String!) { product(slug: $slug) { id name slug description featuredAsset { id name preview } assets { id name } facetValues { id code name } collections { id slug name } } }",
  "variables": {
    "slug": "desktop"
  }
}

### Test Get Collections (to get valid collection IDs)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetCollectionsTest { collections { items { id slug name } totalItems } }"
}

### Test Get Facet Values (to get valid facet value IDs)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetFacetValuesTest { facetValues(options: { take: 100 }) { items { id code name facet { code } } totalItems } }"
}

### Test Get Assets (to get valid asset IDs)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetAssetsTest { assets(options: { take: 100 }) { items { id name } totalItems } }"
}