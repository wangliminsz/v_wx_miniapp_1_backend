############################################### 列出所有 Assets ~~~~~~~~~ OK OK OK    1
### 1 List all assets

POST http://192.168.0.53:3000/admin-api
Content-Type: application/json
Authorization: Bearer a37cdcc31961a72688af1991038f0c36f23ecf3fd7e0df094b0a173cb2e831c7

{
  "query": "query ListAssets($options: AssetListOptions){ assets(options:$options){ items{ id name source preview createdAt } totalItems } }",
  "variables": { "options": { "take": 500, "skip": 0 } }
}


##### 简单版本


POST http://192.168.0.53:3000/admin-api
Content-Type: application/json
Authorization: Bearer a37cdcc31961a72688af1991038f0c36f23ecf3fd7e0df094b0a173cb2e831c7

{
  "query": "query ListAssets($options: AssetListOptions){ assets(options:$options){ items{ id name } totalItems } }",
  "variables": { "options": { "take": 1000, "skip": 0 } }
}




