############################################### 列出 Product / Variant 的引用 ~~ OK    2

POST http://192.168.0.53:3000/admin-api
Content-Type: application/json
Authorization: Bearer a37cdcc31961a72688af1991038f0c36f23ecf3fd7e0df094b0a173cb2e831c7

{
  "query": "query ProductsWithAssets($options: ProductListOptions){ products(options:$options){ items{ id slug assets{ id name } featuredAsset{ id name } variants{ id sku assets{ id name } featuredAsset{ id name } } } totalItems } }",
  "variables": { "options": { "take": 500, "skip": 0 } }
}

######

POST http://192.168.0.53:3000/admin-api
Content-Type: application/json
Authorization: Bearer a37cdcc31961a72688af1991038f0c36f23ecf3fd7e0df094b0a173cb2e831c7

{
  "query": "query Products($options: ProductListOptions) { products(options: $options) { items { slug featuredAsset { name } } totalItems } }",
  "variables": {
    "options": {
      "take": 500,
      "skip": 0
    }
  }
}



############################################### 列出 Product / Variant 的引用 ~~ OK    2


############################################### 列出 Collections 的 Assets ~~~~~ OK    3

POST http://192.168.0.53:3000/admin-api
Content-Type: application/json
Authorization: Bearer a37cdcc31961a72688af1991038f0c36f23ecf3fd7e0df094b0a173cb2e831c7

{
  "query": "query CollectionsWithAssets($options: CollectionListOptions){ collections(options:$options){ items{ id name featuredAsset{ id name } } totalItems } }",
  "variables": { "options": { "take": 200, "skip": 0 } }
}


