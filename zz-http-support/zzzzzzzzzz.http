# =============================================
# Update Collection - Add Chinese translation
# =============================================

POST http://192.168.0.51:3000/admin-api
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "query": "mutation UpdateCollectionZh($input: UpdateCollectionInput!) { updateCollection(input: $input) { id name slug description translations { languageCode name slug description } } }",
  "variables": {
    "input": {
      "id": "5",            
      "translations": [
        {
          "languageCode": "zh",
          "name": "家居园艺",
          "slug": "home-garden", 
          "description": ""
        }
      ]
    }
  }
}