###############################################  TOKEN TOKEN TOKEN OK OK OK OK OK



### 1. Update Facet name (e.g. "Brand" → "品牌")
POST http://192.168.0.51:3000/admin-api
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "query": "mutation UpdateFacet($input: UpdateFacetInput!) { updateFacet(input: $input) { id code name translations { languageCode name } } }",
  "variables": {
    "input": {
      "id": "2",
      "translations": [
        {
          "languageCode": "zh",
          "name": "品牌"
        }
      ]
    }
  }
}


#######################

### 2. Update single FacetValue (e.g. "Apple" → "苹果")
POST http://192.168.0.51:3000/admin-api
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "query": "mutation UpdateFacetValue($input: UpdateFacetValueInput!) { updateFacetValue(input: $input) { id code name translations { languageCode name } facet { id name } } }",
  "variables": {
    "input": {
      "id": "3",
      "translations": [
        {
          "languageCode": "zh",
          "name": "苹果"
        }
      ]
    }
  }
}


###########################

### 拿到所有 Facet Group ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ OK OK OK

POST http://192.168.0.51:3000/admin-api
Content-Type: application/json
Authorization: Bearer 4e18be2c9f8d46c98dcab42821c018ddb00f52597f2afe282cde712d30e81894

{
  "query": "query GetAllFacets($options: FacetListOptions) { facets(options: $options) { totalItems items { id name code isPrivate } } }",
  "variables": {
    "options": {
      "take": 1000,
      "skip": 0
    }
  }
}

### 3. Bonus: See current translations of a Facet + all its values
POST http://192.168.0.51:3000/admin-api
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "query": "query GetFacetTranslations($id: ID!) { facet(id: $id) { id code name translations { languageCode name } values { id code name translations { languageCode name } } } }",
  "variables": {
    "id": "2"
  }
}


