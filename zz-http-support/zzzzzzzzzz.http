#### 列出所有 Collections  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ OK OK OK


POST http://192.168.0.51:3000/admin-api
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "query": "query ListProductOptions($options: ProductOptionListOptions){ productOptions(options:$options){ items{ id code name group{ id code name } translations{ languageCode name } } totalItems }}",
  "variables": { "options": { "take": 100, "skip": 0 } }
}




#### 列出所有 Collections  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ OK OK OK

POST http://192.168.0.51:3000/admin-api
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "query": "query { collections { items { id name slug description parent { id name } featuredAsset { id preview } } totalItems } }"
}

