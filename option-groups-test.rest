@baseUrl = http://localhost:3000/admin-api
@token = YOUR_AUTH_TOKEN

### Get All Option Groups
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetAllOptionGroups { productOptionGroups { id code name options { id code name } } }"
}

### Create Option Group with Options
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreateOptionGroup($input: CreateProductOptionGroupInput!) { createProductOptionGroup(input: $input) { id code name options { id code name } } }",
  "variables": {
    "input": {
      "code": "desktop-screen-size",
      "translations": [{
        "languageCode": "en",
        "name": "Desktop Screen Size"
      }],
      "options": [
        {
          "code": "19-inch",
          "translations": [{
            "languageCode": "en",
            "name": "19-inch"
          }]
        },
        {
          "code": "21-inch",
          "translations": [{
            "languageCode": "en",
            "name": "21-inch"
          }]
        }
      ]
    }
  }
}

