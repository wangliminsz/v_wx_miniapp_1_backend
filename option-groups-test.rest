### Add Option Group to Product
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation AddOptionGroupToProduct($productId: ID!, $optionGroupId: ID!) { addOptionGroupToProduct(productId: $productId, optionGroupId: $optionGroupId) { id name optionGroups { id code name options { id code name } } } }",
  "variables": {
    "productId": "PRODUCT_ID",
    "optionGroupId": "OPTION_GROUP_ID"
  }
}

### Create Product with Options Flow
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreateProduct($input: CreateProductInput!) { createProduct(input: $input) { id name slug } }",
  "variables": {
    "input": {
      "translations": [{
        "languageCode": "en",
        "name": "Test Product",
        "slug": "test-product",
        "description": "Test product description"
      }]
    }
  }
}

### Verify Product with Option Groups
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetProductWithOptions($slug: String!) { product(slug: $slug) { id name slug optionGroups { id code name options { id code name } } } }",
  "variables": {
    "slug": "test-product"
  }
}